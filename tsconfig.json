{
  "compilerOptions": {
    "target": "ES2017",
    "module": "none",
    "ignoreDeprecations": "6.0",
    "strict": true,
    "alwaysStrict": false,
    "noImplicitAny": true,
    "lib": ["DOM", "ES2017"],
    "rootDir": "src",
    "outDir": "."
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules"]
}
